# Public browser configuration; use the project's publishable/anon key, never service_role.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-project-publishable-key
# Legacy anon keys are also supported via VITE_SUPABASE_ANON_KEY.

# Optional server-side AI sorting. Never prefix these with VITE_.
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Optional server aliases; otherwise the server uses the public VITE_ configuration.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-project-public-key

# Existing public geocoding utility; standard workflow needs no Google Maps key.
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
PORT=5173
