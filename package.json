{
  "name": "pulso-marinduque",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.mjs --dev",
    "build": "tsc && vite build",
    "preview": "npm run start",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "reference:generate": "node scripts/generate-reference.mjs",
    "seed:generate": "node scripts/generate-seed.mjs",
    "test:browser": "playwright test",
    "format:check": "prettier --check src scripts server tests e2e '*.ts' '*.json' '*.mjs' '*.html' 'docs/*.md' README.md"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aivangogh/ph-address": "^2026.2.4",
    "@electric-sql/pglite": "^0.5.12",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.16",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.6",
    "postcss": "^8.5.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  }
}
